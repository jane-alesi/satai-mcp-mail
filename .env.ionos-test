# IONOS Test Environment Variables
# Copy to .env.ionos-test.local and update with actual credentials

export MCP_EMAIL_SERVER_CONFIG_PATH="./config-ionos-test.toml"
export IONOS_TEST_EMAIL="test@satware.ai"
export IONOS_TEST_PASSWORD="your-secure-password"
export IONOS_TEST_FULL_NAME="satware® AI Test System"

# Security settings
export MCP_EMAIL_SERVER_LOG_LEVEL="DEBUG"
export MCP_EMAIL_SERVER_ENABLE_AUDIT_LOG="true"

# IONOS Server Settings (for reference)
export IONOS_IMAP_HOST="imap.ionos.com"
export IONOS_IMAP_PORT="993"
export IONOS_SMTP_HOST="smtp.ionos.com"
export IONOS_SMTP_PORT="587"

# Testing Configuration
export PYTEST_TIMEOUT="30"
export IONOS_TEST_FOLDER="INBOX"
export IONOS_MAX_TEST_EMAILS="10"